# ========================================================
# 1. 마크다운(Markdown) 기본 통계 제외
# ========================================================
*.md linguist-detectable=false

# ========================================================
# 2. 폴더별 언어 강제 매핑 (인프라 & 데브옵스 스택)
# ========================================================

# 1) LINUX & 2) Shell Script -> Shell (리눅스 쉘)
*LINUX*/** linguist-language=Shell
*LINUX*/** linguist-detectable=true
*Shell*Script*/** linguist-language=Shell
*Shell*Script*/** linguist-detectable=true

# 3) HTML, DB -> HTML 
*HTML*DB*/** linguist-language=HTML
*HTML*DB*/** linguist-detectable=true

# 4) Docker -> Dockerfile (도커 공식 언어)
*Docker*/** linguist-language=Dockerfile
*Docker*/** linguist-detectable=true

# 5) Kuberneties -> Go (쿠버네티스 코어 언어)
*Kuberneties*/** linguist-language=Go
*Kuberneties*/** linguist-detectable=true

# 6) Ansible -> Python (앤서블 기반 언어)
*Ansible*/** linguist-language=Python
*Ansible*/** linguist-detectable=true

# 7) AWS -> Python (Boto3 스크립트 느낌)
*AWS*/** linguist-language=Python
*AWS*/** linguist-detectable=true

# 8) Terraform -> HCL (테라폼 공식 언어)
*Terraform*/** linguist-language=HCL
*Terraform*/** linguist-detectable=true

# 기존 Network & System
*Network*/** linguist-language=HCL
*Network*/** linguist-detectable=true
*System*/** linguist-language=Shell
*System*/** linguist-detectable=true

# ========================================================
# 3. 옵시디언(Obsidian) 설정 파일 포함 (웹/설정 스택 추가)
# ========================================================
# 테마 파일은 CSS로, 플러그인은 JS로, 설정은 JSON으로 인식!
.obsidian/**/*.css linguist-language=CSS
.obsidian/**/*.css linguist-detectable=true
.obsidian/**/*.js linguist-language=JavaScript
.obsidian/**/*.js linguist-detectable=true
.obsidian/**/*.json linguist-language=JSON
.obsidian/**/*.json linguist-detectable=true
